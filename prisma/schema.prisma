generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Person {
  id          Int          @id @default(autoincrement())
  name        String
  birthYear   Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  readings    Reading[]
  medications Medication[]
  batchJobs   BatchJob[]
}

model Reading {
  id        Int      @id @default(autoincrement())
  systolic  Int
  diastolic Int
  pulse     Int
  age       Int?
  note      String?
  image     String?
  // Kontekst-tags: morgen/aften og arm (valgfri, valideres i API-laget)
  timeOfDay String?
  arm       String?
  personId  Int
  person    Person   @relation(fields: [personId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Batch-job items der blev auto-gemt fra dette målepunkt
  batchJobItems BatchJobItem[]

  @@index([createdAt])
  @@index([personId])
}

model Medication {
  id        Int       @id @default(autoincrement())
  personId  Int
  person    Person    @relation(fields: [personId], references: [id])
  name      String
  dose      String
  startDate DateTime?
  endDate   DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([personId])
}

// Server-side batch-scan queue (issue: multi-upload robustness).
// Job status: pending | processing | done | cancelled.
model BatchJob {
  id        String         @id @default(cuid())
  personId  Int
  person    Person         @relation(fields: [personId], references: [id])
  status    String         @default("pending")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  items     BatchJobItem[]

  @@index([status])
}

// Item status: pending | scanning | saved | error.
model BatchJobItem {
  id         Int      @id @default(autoincrement())
  jobId      String
  job        BatchJob @relation(fields: [jobId], references: [id])
  imagePath  String // filnavn i scan-captures/
  imageHash  String? // SHA-256 over det komprimerede billede, brugt til deduplication
  capturedAt DateTime? // EXIF-optagelsestid sendt fra klienten
  status     String   @default("pending")
  readingId  Int?
  reading    Reading? @relation(fields: [readingId], references: [id])
  error      String?
  clientRef  String? // klientens billed-id — bruges til at matche UI-thumbnails
  // Manual entry fields (for failed OCR images)
  manualSystolic   Int?
  manualDiastolic  Int?
  manualPulse      Int?
  manualTimeOfDay  String?
  manualArm        String?
  manualNote       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([jobId, status])
  @@index([imageHash])
}