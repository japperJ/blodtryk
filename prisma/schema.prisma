generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Person {
  id          Int          @id @default(autoincrement())
  name        String
  birthYear   Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  readings    Reading[]
  medications Medication[]
}

model Reading {
  id        Int      @id @default(autoincrement())
  systolic  Int
  diastolic Int
  pulse     Int
  age       Int?
  note      String?
  image     String?
  // Kontekst-tags: morgen/aften og arm (valgfri, valideres i API-laget)
  timeOfDay String?
  arm       String?
  personId  Int
  person    Person   @relation(fields: [personId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([personId])
}

model Medication {
  id        Int       @id @default(autoincrement())
  personId  Int
  person    Person    @relation(fields: [personId], references: [id])
  name      String
  dose      String
  startDate DateTime?
  endDate   DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([personId])
}